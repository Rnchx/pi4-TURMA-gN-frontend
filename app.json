{
  "expo": {
    "name": "rn-boilerplate",
    "slug": "rn-boilerplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/design/images/icone-app-safra-online.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/design/images/tela-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2852"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/design/images/monograma-safra-transparente.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/design/images/icone-app-safra-online.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
