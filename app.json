{
  "expo": {
    "name": "SAFRA Online",
    "slug": "safra-online",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/design/images/icone-app-safra-online.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5EF",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/design/images/monograma-safra-transparente.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/design/images/icone-app-safra-online.png",
      "bundler": "metro",
      "name": "SAFRA Online",
      "themeColor": "#1E6B43",
      "backgroundColor": "#F7F5EF"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/design/images/icone-app-safra-online.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
